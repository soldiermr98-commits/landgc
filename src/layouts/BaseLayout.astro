---
import '@fontsource-variable/vazirmatn';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/motion.css';
import vazirmatnArabic from '@fontsource-variable/vazirmatn/files/vazirmatn-arabic-wght-normal.woff2?url';
import faviconUrl from '../assets/favicon.svg?url';
import ogImageAsset from '../assets/og-image.png';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { SITE_URL, links, site, social, store } from '../config/site';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.title, description = site.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
// Assets are fingerprinted under /_astro/ (and honour ASSETS_PREFIX), so they also work
// when the build is served from a sub-folder.
const ogImage = new URL(ogImageAsset.src, site.url).href;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${SITE_URL}/#organization`,
    name: site.name,
    alternateName: site.nameLatin,
    url: site.url,
    logo: site.officialLogo,
    description: site.description,
    ...(social.length ? { sameAs: social.map((s) => s.url) } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE_URL}/#website`,
    url: site.url,
    name: site.name,
    alternateName: site.nameLatin,
    inLanguage: 'fa-IR',
    publisher: { '@id': `${SITE_URL}/#organization` },
    potentialAction: {
      '@type': 'SearchAction',
      target: { '@type': 'EntryPoint', urlTemplate: links.searchTemplate },
      'query-input': 'required name=search_term_string',
    },
  },
];

/** Runtime settings read by scripts (kept in JSON so no inline JS is needed). */
const runtime = { storeApi: store.apiBase, cartUrl: links.cart };
---

<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content={site.themeColor} />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href={faviconUrl} type="image/svg+xml" />
    <link rel="preload" href={vazirmatnArabic} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(ogImageAsset.width)} />
    <meta property="og:image:height" content={String(ogImageAsset.height)} />
    <meta property="og:image:alt" content={site.title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline>
      // Enables reveal animations only when JS runs; if the main bundle never initialises,
      // content is revealed anyway after 3 s so nothing stays hidden.
      document.documentElement.classList.add('js');
      setTimeout(function () {
        var root = document.documentElement;
        if (!root.classList.contains('motion-ready')) root.classList.add('reveal-fallback');
      }, 3000);
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#main">پرش به محتوای اصلی</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />

    <script type="application/json" id="gc-runtime" set:html={JSON.stringify(runtime)} />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
