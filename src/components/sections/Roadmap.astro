---
/**
 * «در حال توسعه و برنامه‌های آینده» — planned areas only. Styled as a blueprint
 * (dashed outlines, no prices, no purchase actions) so nothing reads as an available product.
 */
import Icon from '../ui/Icon.astro';
import Button from '../ui/Button.astro';
import { roadmap, roadmapSection as copy } from '../../data/roadmap';
import { faIndex } from '../../lib/format';
---

<section class="section section--light roadmap" id="roadmap" aria-labelledby="roadmap-title">
  <div class="roadmap__blueprint" aria-hidden="true"></div>

  <div class="container roadmap__inner">
    <div class="roadmap__content">
      <p class="roadmap__badge" data-reveal>
        <span class="roadmap__badge-icon" aria-hidden="true"><Icon name="git-branch" size={16} /></span>
        {copy.badge}
      </p>
      <h2 class="roadmap__title" id="roadmap-title" data-reveal style="--reveal-i:1">{copy.title}</h2>
      <p class="roadmap__desc" data-reveal style="--reveal-i:2">{copy.description}</p>
      <p class="roadmap__note" data-reveal style="--reveal-i:3">
        <Icon name="circle-question-mark" size={16} />
        {copy.disclaimer}
      </p>
      <div data-reveal style="--reveal-i:4">
        <Button href={copy.cta.href} variant="link">{copy.cta.label}</Button>
      </div>
    </div>

    <div class="roadmap__track">
      <h3 class="roadmap__list-title" data-reveal>{copy.listTitle}</h3>
      <ol class="roadmap__list">
        {
          roadmap.map((item, i) => (
            <li class="roadmap__item" data-reveal style={`--reveal-i:${i}`}>
              <span class="roadmap__node" aria-hidden="true" />
              <div class="roadmap__card">
                <span class="roadmap__icon">
                  <Icon name={item.icon} size={22} />
                </span>
                <span class="roadmap__text">
                  <span class="roadmap__index">حوزه {faIndex(i + 1)}</span>
                  <span class="roadmap__name">{item.title}</span>
                </span>
                <span class="roadmap__status">برنامه آینده</span>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .roadmap {
    background:
      radial-gradient(55% 70% at 0% 100%, rgb(25 197 139 / 0.14), transparent 70%),
      radial-gradient(40% 50% at 100% 0%, rgb(163 244 81 / 0.12), transparent 70%),
      var(--c-mint-50);
  }

  .roadmap__blueprint {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(rgb(11 68 53 / 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgb(11 68 53 / 0.06) 1px, transparent 1px),
      linear-gradient(rgb(11 68 53 / 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgb(11 68 53 / 0.03) 1px, transparent 1px);
    background-size:
      96px 96px,
      96px 96px,
      24px 24px,
      24px 24px;
    -webkit-mask-image: linear-gradient(to left, transparent 5%, #000 55%, #000 90%, transparent);
    mask-image: linear-gradient(to left, transparent 5%, #000 55%, #000 90%, transparent);
  }

  .roadmap__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    align-items: center;
    gap: clamp(2.5rem, 6vw, 6rem);
  }

  .roadmap__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.4rem 0.85rem 0.4rem 1rem;
    border: 1px dashed rgb(11 68 53 / 0.35);
    border-radius: var(--r-sm);
    background: rgb(255 255 255 / 0.7);
    font-size: var(--fs-sm);
    font-weight: 700;
    color: var(--c-green-ink);
  }

  .roadmap__badge-icon {
    display: grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    background: var(--c-ink-950);
    color: var(--c-lime);
  }

  .roadmap__title {
    margin-top: 1.25rem;
    font-size: var(--fs-h2);
    color: var(--c-text);
  }

  .roadmap__desc {
    margin-top: 1.1rem;
    font-size: var(--fs-md);
    color: var(--c-text-muted);
  }

  .roadmap__note {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    margin-block: 1.4rem 0.75rem;
    padding: 0.8rem 1rem;
    border-radius: var(--r-md);
    background: rgb(255 255 255 / 0.75);
    border: 1px solid var(--c-line);
    font-size: var(--fs-sm);
    line-height: 1.85;
    color: var(--c-text-muted);
  }

  .roadmap__note :global(svg) {
    margin-top: 0.3rem;
    color: var(--c-green-ink);
  }

  .roadmap__list-title {
    margin-bottom: 1.25rem;
    padding-inline-start: 2.75rem;
    font-size: var(--fs-sm);
    font-weight: 700;
    color: var(--c-text-muted);
  }

  .roadmap__list {
    position: relative;
    display: grid;
    gap: 1rem;
  }

  /* dashed trace connecting the nodes */
  .roadmap__list::before {
    content: '';
    position: absolute;
    inset-inline-start: 0.7rem;
    top: 1.5rem;
    bottom: 1.5rem;
    border-inline-start: 2px dashed rgb(25 197 139 / 0.45);
  }

  .roadmap__item {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .roadmap__node {
    position: relative;
    z-index: 1;
    width: 1.5rem;
    height: 1.5rem;
    flex-shrink: 0;
    border-radius: 50%;
    border: 2px solid var(--c-green);
    background: var(--c-mint-50);
    box-shadow: 0 0 0 5px rgb(25 197 139 / 0.1);
  }

  .roadmap__node::after {
    content: '';
    position: absolute;
    inset: 4px;
    border-radius: 50%;
    background: var(--c-green);
    opacity: 0.35;
  }

  .roadmap__card {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.15rem;
    border-radius: var(--r-md);
    border: 1px dashed rgb(11 68 53 / 0.28);
    background: rgb(255 255 255 / 0.8);
    transition:
      border-color var(--dur-2),
      translate var(--dur-3) var(--ease-out),
      box-shadow var(--dur-3);
  }

  .roadmap__card:hover {
    translate: -4px 0;
    border-color: rgb(25 197 139 / 0.6);
    box-shadow: 0 18px 36px -24px rgb(6 39 31 / 0.4);
  }

  .roadmap__icon {
    display: grid;
    place-items: center;
    width: 2.9rem;
    height: 2.9rem;
    flex-shrink: 0;
    border-radius: var(--r-md);
    border: 1px dashed rgb(25 197 139 / 0.55);
    color: var(--c-green-ink);
    background: rgb(25 197 139 / 0.06);
    transition: transform var(--dur-3) var(--ease-out);
  }

  .roadmap__card:hover .roadmap__icon {
    transform: rotate(-6deg);
  }

  .roadmap__text {
    display: grid;
    gap: 0.1rem;
    min-width: 0;
  }

  .roadmap__index {
    font-size: var(--fs-2xs);
    font-weight: 700;
    color: var(--c-text-muted);
  }

  .roadmap__name {
    font-size: var(--fs-base);
    font-weight: 800;
    line-height: 1.6;
    color: var(--c-text);
  }

  .roadmap__status {
    margin-inline-start: auto;
    padding: 0.2rem 0.55rem;
    border-radius: var(--r-xs);
    background: rgb(23 43 37 / 0.06);
    font-size: var(--fs-2xs);
    font-weight: 700;
    color: var(--c-text-muted);
    white-space: nowrap;
  }

  @media (max-width: 1023.98px) {
    .roadmap__inner {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 479.98px) {
    .roadmap__status {
      display: none;
    }
  }
</style>
