---
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../ui/Icon.astro';
import CircuitField from '../circuits/CircuitField.astro';
import CoreChip from '../circuits/CoreChip.astro';
import { capabilities, capabilitiesSection as copy } from '../../data/capabilities';
---

<section
  class="section section--dark capabilities"
  id="capabilities"
  aria-labelledby="capabilities-title"
  data-progress
  data-visibility
>
  <div class="capabilities__light" aria-hidden="true"></div>
  <CircuitField variant="dark" tone="dark" parallax />

  <div class="container capabilities__inner">
    <div class="capabilities__content">
      <SectionHeading id="capabilities-title" eyebrow={copy.eyebrow} title={copy.title} tone="dark" />
      <div class="capabilities__text">
        {
          copy.paragraphs.map((p, i) => (
            <p data-reveal style={`--reveal-i:${i + 2}`}>
              {p}
            </p>
          ))
        }
      </div>
      <ul class="capabilities__list">
        {
          capabilities.map((item, i) => (
            <li class="capabilities__item" data-reveal style={`--reveal-i:${i}`}>
              <span class="capabilities__icon">
                <Icon name={item.icon} size={20} />
              </span>
              <span>{item.label}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="capabilities__visual">
      <CoreChip />
    </div>
  </div>
</section>

<style>
  /* light that drifts subtly with scroll progress */
  .capabilities__light {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      radial-gradient(
        40% 55% at calc(18% + var(--p, 0.5) * 12%) calc(30% + var(--p, 0.5) * 30%),
        rgb(25 197 139 / 0.16),
        transparent 70%
      ),
      radial-gradient(45% 50% at 95% 100%, rgb(11 68 53 / 0.9), transparent 70%);
  }

  .capabilities__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2.5rem, 5vw, 5rem);
  }

  .capabilities__text {
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
    font-size: var(--fs-md);
    color: var(--c-on-dark-muted);
  }

  .capabilities__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  .capabilities__item {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.9rem 1rem;
    border-radius: var(--r-md);
    border: 1px solid var(--c-line-dark);
    background: rgb(233 247 240 / 0.03);
    font-size: var(--fs-sm);
    font-weight: 600;
    line-height: 1.7;
    color: var(--c-on-dark);
    transition:
      border-color var(--dur-2),
      background-color var(--dur-2);
  }

  .capabilities__item:hover {
    border-color: rgb(25 197 139 / 0.45);
    background: rgb(25 197 139 / 0.07);
  }

  .capabilities__icon {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    flex-shrink: 0;
    border-radius: var(--r-sm);
    background: rgb(163 244 81 / 0.1);
    color: var(--c-lime);
    transition: transform var(--dur-3) var(--ease-out);
  }

  .capabilities__item:hover .capabilities__icon {
    transform: rotate(-6deg) scale(1.06);
  }

  @media (max-width: 1023.98px) {
    .capabilities__inner {
      grid-template-columns: 1fr;
    }

    .capabilities__visual {
      width: min(100%, 520px);
      margin-inline: auto;
    }
  }

  @media (max-width: 559.98px) {
    .capabilities__list {
      grid-template-columns: 1fr;
    }

    /* room for the technology labels that sit outside the chip artwork */
    .capabilities__visual {
      padding-inline: 1.75rem;
    }
  }
</style>
