---
/**
 * Products section.
 * Product cards are rendered in the browser from the live WooCommerce Store API
 * (scripts/products/*). Markup for every state lives here as <template>s, so the JS only
 * fills in data. Nothing product-related (name, price, image, link) is hardcoded.
 *
 * Desktop layout: featured card (8 cols, 2 rows) + side column (4 cols) + extra rows of 3.
 */
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import CircuitField from '../circuits/CircuitField.astro';
import { links, store } from '../../config/site';
import { productsSection as copy } from '../../data/products';

const runtimeConfig = {
  apiBase: store.apiBase,
  perPage: store.perPage,
  timeoutMs: store.timeoutMs,
  preferredFeaturedId: store.preferredFeaturedId,
  summaries: store.summaries,
  cartUrl: links.cart,
  copy: {
    unavailable: copy.unavailable,
    empty: copy.empty,
  },
};

/** 1×1 transparent GIF: keeps the inert <template> markup valid; render.ts always sets the real src. */
const BLANK_IMG = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';
---

<section
  id="products"
  class="section section--light products"
  aria-labelledby="products-title"
  data-products-root
  data-visibility
>
  <CircuitField variant="light" tone="light" />

  <div class="container">
    <SectionHeading id="products-title" eyebrow={copy.eyebrow} title={copy.title} description={copy.description} />

    <div class="products__grid" data-products-grid aria-busy="true">
      <!-- Loading skeletons: same geometry as the final cards (no layout jump) -->
      <div class="products__item products__item--featured" data-skeleton aria-hidden="true">
        <div class="p-card p-card--featured p-card--skeleton">
          <div class="p-card__inner">
            <div class="p-card__media skel"></div>
            <div class="p-card__body">
              <span class="skel skel--chip"></span>
              <span class="skel skel--title"></span>
              <span class="skel skel--line"></span>
              <span class="skel skel--line skel--short"></span>
              <span class="skel skel--line skel--tiny"></span>
              <span class="skel skel--line skel--tiny"></span>
              <span class="skel skel--btn"></span>
            </div>
          </div>
        </div>
      </div>
      <div class="products__item" data-skeleton aria-hidden="true">
        <div class="p-card p-card--skeleton">
          <div class="p-card__inner">
            <div class="p-card__media skel"></div>
            <div class="p-card__body">
              <span class="skel skel--chip"></span>
              <span class="skel skel--title"></span>
              <span class="skel skel--line"></span>
              <span class="skel skel--btn"></span>
            </div>
          </div>
        </div>
      </div>

      <!-- Custom software entry point: not a store product, so no price -->
      <div class="products__item" data-products-custom data-reveal>
        <article class="p-card p-card--custom" data-spotlight aria-labelledby="custom-solutions-title">
          <div class="p-card__inner">
            <div class="p-card__art" aria-hidden="true">
              <svg viewBox="0 0 320 120" preserveAspectRatio="xMidYMid slice" focusable="false">
                <path d="M0 30 H96 L116 50 H150" class="p-card__art-trace"></path>
                <path d="M0 90 H70 L90 70 H150" class="p-card__art-trace"></path>
                <path d="M170 60 H230 L250 40 H320" class="p-card__art-trace"></path>
                <path d="M170 60 H214 L234 80 H320" class="p-card__art-trace"></path>
                <path d="M0 30 H96 L116 50 H150" class="p-card__art-pulse" pathLength="1"></path>
                <path d="M170 60 H230 L250 40 H320" class="p-card__art-pulse p-card__art-pulse--b" pathLength="1"
                ></path>
                <rect x="140" y="36" width="40" height="48" rx="6" class="p-card__art-chip"></rect>
                <circle cx="320" cy="40" r="3" class="p-card__art-node"></circle>
              </svg>
              <span class="p-card__art-icon"><Icon name="cpu" size={22} /></span>
            </div>
            <div class="p-card__body">
              <span class="p-card__cat p-card__cat--dark">{copy.custom.label}</span>
              <h3 class="p-card__title" id="custom-solutions-title">{copy.custom.title}</h3>
              <p class="p-card__desc">{copy.custom.description}</p>
              <div class="p-card__footer">
                <Button href={copy.custom.cta.href} variant="primary" size="sm">{copy.custom.cta.label}</Button>
              </div>
            </div>
          </div>
        </article>
      </div>
    </div>

    <div class="products__footer" data-reveal>
      <Button href={copy.allProducts.href} variant="dark" size="lg">{copy.allProducts.label}</Button>
    </div>
  </div>

  <script type="application/json" data-products-config set:html={JSON.stringify(runtimeConfig)} />

  <!-- ===== Templates used by scripts/products/render.ts ===== -->
  <template data-tpl="featured">
    <div class="products__item products__item--featured" data-reveal>
      <article class="p-card p-card--featured" data-spotlight>
        <div class="p-card__inner">
          <a class="p-card__media" data-slot="media" tabindex="-1" aria-hidden="true">
            <img data-slot="image" src={BLANK_IMG} alt="" width="750" height="500" decoding="async" />
            <span class="p-card__fallback"><Icon name="package" size={36} /></span>
            <span class="p-card__badge"><Icon name="sparkles" size={14} />محصول شاخص</span>
          </a>
          <div class="p-card__body">
            <span class="p-card__cat" data-slot="category"></span>
            <h3 class="p-card__title"><a data-slot="title" href={links.shop}>محصول</a></h3>
            <p class="p-card__desc" data-slot="summary"></p>
            <ul class="p-card__highlights" data-slot="highlights"></ul>
            <div class="p-card__footer">
              <div class="p-card__price" data-slot="price"></div>
              <div class="p-card__actions">
                <Button href={links.shop} variant="dark" data-slot="details">{copy.cardCta}</Button>
                <a class="p-card__cart" href={links.cart} data-slot="add-to-cart" hidden>
                  <Icon name="shopping-cart" size={18} />
                  افزودن به سبد خرید
                </a>
              </div>
            </div>
          </div>
        </div>
      </article>
    </div>
  </template>

  <template data-tpl="card">
    <div class="products__item" data-reveal>
      <article class="p-card" data-spotlight>
        <div class="p-card__inner">
          <a class="p-card__media" data-slot="media" tabindex="-1" aria-hidden="true">
            <img data-slot="image" src={BLANK_IMG} alt="" width="750" height="500" decoding="async" loading="lazy" />
            <span class="p-card__fallback"><Icon name="package" size={30} /></span>
          </a>
          <div class="p-card__body">
            <span class="p-card__cat" data-slot="category"></span>
            <h3 class="p-card__title"><a data-slot="title" href={links.shop}>محصول</a></h3>
            <p class="p-card__desc" data-slot="summary"></p>
            <div class="p-card__footer">
              <div class="p-card__price" data-slot="price"></div>
              <Button href={links.shop} variant="outline" size="sm" data-slot="details">{copy.cardCta}</Button>
            </div>
          </div>
        </div>
      </article>
    </div>
  </template>

  <template data-tpl="highlight">
    <li><Icon name="check" size={16} strokeWidth={2.2} /><span data-slot="text"></span></li>
  </template>

  <template data-tpl="price">
    <span class="price">
      <del class="price__regular" data-slot="regular" hidden></del>
      <span class="price__now">
        <span class="price__prefix" data-slot="prefix" hidden></span>
        <data class="price__amount" data-slot="amount"></data>
        <span class="price__unit" data-slot="unit"></span>
      </span>
    </span>
  </template>

  <template data-tpl="price-inquiry">
    <span class="price price--inquiry">قیمت در صفحه محصول</span>
  </template>

  <template data-tpl="notice">
    <div class="products__item products__item--featured products__item--notice" role="status" data-reveal>
      <div class="p-notice">
        <span class="p-notice__icon"><Icon name="store" size={26} /></span>
        <h3 class="p-notice__title" data-slot="title">{copy.unavailable.title}</h3>
        <p class="p-notice__body" data-slot="body"></p>
        <Button href={links.shop} variant="dark">{copy.unavailable.cta}</Button>
      </div>
    </div>
  </template>
</section>

<style>
  .products__grid {
    --gap: clamp(1rem, 1.6vw, 1.5rem);
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--gap);
    margin-top: clamp(2.5rem, 4vw, 3.5rem);
  }

  .products__item {
    grid-column: span 12;
    display: flex;
    min-width: 0;
  }

  .products__item > :global(*) {
    flex: 1;
    min-width: 0;
  }

  /* tablet: two per row, an odd last item takes the full row */
  @media (min-width: 768px) and (max-width: 1023.98px) {
    .products__item:not(.products__item--featured) {
      grid-column: span 6;
    }

    .products__item:not(.products__item--featured):nth-child(even):last-child {
      grid-column: span 12;
    }
  }

  @media (min-width: 1024px) {
    .products__item--featured {
      grid-column: span 8;
      grid-row: span 2;
    }

    .products__item:not(.products__item--featured) {
      grid-column: span 4;
    }

    /* single side item → fill both rows of the side column */
    .products__item--featured + .products__item:last-child {
      grid-row: span 2;
    }

    /* items after the side column: distribute the last row */
    .products__item:nth-child(3n + 4):last-child {
      grid-column: span 12;
    }

    .products__item:nth-child(3n + 5):last-child,
    .products__item:nth-child(3n + 4):nth-last-child(2) {
      grid-column: span 6;
    }
  }

  .products__footer {
    display: flex;
    justify-content: center;
    margin-top: clamp(2.5rem, 4vw, 3.5rem);
  }

  /* ================= Card ================= */
  .p-card {
    position: relative;
    isolation: isolate;
    container-type: inline-size;
    display: flex;
    border-radius: var(--r-lg);
    background: var(--c-white);
    border: 1px solid var(--c-line);
    box-shadow: var(--shadow-sm);
    transition:
      translate var(--dur-3) var(--ease-out),
      box-shadow var(--dur-3) var(--ease-out),
      border-color var(--dur-2);
  }

  /* lit border that follows the pointer (spotlight.ts sets --mx/--my) */
  .p-card::before {
    content: '';
    position: absolute;
    inset: -1px;
    z-index: 2;
    padding: 1px;
    border-radius: inherit;
    background: radial-gradient(
      320px circle at var(--mx, 50%) var(--my, 0%),
      rgb(25 197 139 / 0.95),
      rgb(163 244 81 / 0.35) 35%,
      transparent 65%
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    opacity: 0;
    transition: opacity var(--dur-3);
    pointer-events: none;
  }

  /* soft inner glow under the pointer */
  .p-card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: radial-gradient(420px circle at var(--mx, 50%) var(--my, 0%), rgb(25 197 139 / 0.07), transparent 55%);
    opacity: 0;
    transition: opacity var(--dur-3);
    pointer-events: none;
  }

  .p-card:hover {
    translate: 0 -5px;
    border-color: rgb(25 197 139 / 0.3);
    box-shadow:
      0 30px 60px -32px rgb(6 39 31 / 0.45),
      0 0 40px -18px rgb(25 197 139 / 0.55);
  }

  .p-card:hover::before,
  .p-card:hover::after,
  .p-card:focus-within::before {
    opacity: 1;
  }

  .p-card__inner {
    display: flex;
    flex-direction: column;
    width: 100%;
    border-radius: inherit;
    overflow: hidden;
  }

  .p-card__media {
    position: relative;
    display: block;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background:
      radial-gradient(80% 90% at 30% 20%, rgb(25 197 139 / 0.28), transparent 60%),
      linear-gradient(135deg, var(--c-ink-900), var(--c-ink-950));
  }

  .p-card__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 0.9s var(--ease-out),
      opacity var(--dur-3);
  }

  .p-card:hover .p-card__media img {
    transform: scale(1.035);
  }

  .p-card__fallback {
    position: absolute;
    inset: 0;
    display: none;
    place-items: center;
    color: rgb(163 244 81 / 0.75);
  }

  .p-card__media.is-broken img {
    opacity: 0;
  }

  .p-card__media.is-broken .p-card__fallback {
    display: grid;
  }

  .p-card__badge {
    position: absolute;
    inset-block-start: 0.9rem;
    inset-inline-start: 0.9rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.65rem;
    border-radius: var(--r-sm);
    background: rgb(6 39 31 / 0.85);
    color: var(--c-lime);
    font-size: var(--fs-xs);
    font-weight: 700;
    line-height: 1.5;
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }

  .p-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.7rem;
    padding: clamp(1.15rem, 2.2cqi, 1.6rem);
  }

  .p-card__cat {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.2rem 0.6rem;
    border-radius: var(--r-xs);
    background: rgb(25 197 139 / 0.1);
    color: var(--c-green-ink);
    font-size: var(--fs-xs);
    font-weight: 700;
    line-height: 1.6;
  }

  .p-card__cat:empty {
    display: none;
  }

  .p-card__title {
    font-size: var(--fs-h3);
    font-weight: 800;
    line-height: 1.55;
    color: var(--c-text);
  }

  .p-card__title a {
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0 1px;
    background-position: 100% 100%;
    background-repeat: no-repeat;
    transition: background-size var(--dur-3) var(--ease-out);
  }

  .p-card__title a:hover {
    background-size: 100% 1px;
  }

  .p-card__desc {
    font-size: var(--fs-sm);
    line-height: 1.95;
    color: var(--c-text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .p-card__desc:empty {
    display: none;
  }

  .p-card__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.9rem 1rem;
    width: 100%;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px dashed var(--c-line-strong);
  }

  /* ----- featured ----- */
  .p-card--featured .p-card__title {
    font-size: clamp(1.3rem, 1.1rem + 0.8vw, 1.75rem);
  }

  .p-card--featured .p-card__desc {
    font-size: var(--fs-base);
    -webkit-line-clamp: 4;
  }

  .p-card__highlights {
    display: grid;
    gap: 0.55rem;
    margin-block: 0.3rem 0.4rem;
  }

  .p-card__highlights:empty {
    display: none;
  }

  .p-card__highlights :global(li) {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: var(--fs-sm);
    font-weight: 600;
    line-height: 1.8;
    color: var(--c-text);
  }

  .p-card__highlights :global(svg) {
    margin-top: 0.3rem;
    padding: 2px;
    width: 1.15rem;
    height: 1.15rem;
    border-radius: 50%;
    background: var(--c-ink-950);
    color: var(--c-lime);
  }

  .p-card__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 1.1rem;
  }

  .p-card__cart {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding-block: 0.4rem;
    font-size: var(--fs-sm);
    font-weight: 700;
    color: var(--c-green-ink);
    transition: color var(--dur-2);
  }

  .p-card__cart:hover {
    color: var(--c-ink-950);
  }

  .p-card__cart :global(svg) {
    transition: transform var(--dur-3) var(--ease-out);
  }

  .p-card__cart:hover :global(svg) {
    transform: translateX(-3px) rotate(-8deg);
  }

  @media (min-width: 768px) and (max-width: 1023.98px) {
    /* tablet: featured becomes a horizontal card */
    .p-card--featured .p-card__inner {
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    }

    .p-card--featured .p-card__media {
      order: 2;
      aspect-ratio: auto;
      min-height: 100%;
    }
  }

  /* ----- price ----- */
  .p-card__price :global(.price) {
    display: grid;
    gap: 0.1rem;
    line-height: 1.3;
  }

  .p-card__price :global(.price__now) {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
  }

  .p-card__price :global(.price__amount) {
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--c-text);
  }

  .p-card--featured .p-card__price :global(.price__amount) {
    font-size: clamp(1.4rem, 1.2rem + 0.6vw, 1.75rem);
  }

  .p-card__price :global(.price__unit),
  .p-card__price :global(.price__prefix) {
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--c-text-muted);
  }

  .p-card__price :global(.price__regular) {
    font-size: var(--fs-xs);
    color: var(--c-text-muted);
  }

  .p-card__price :global(.price--inquiry) {
    font-size: var(--fs-sm);
    font-weight: 700;
    color: var(--c-green-ink);
  }

  /* ----- custom solutions card (dark) ----- */
  .p-card--custom {
    --focus-ring: var(--c-lime);
    background: linear-gradient(160deg, var(--c-ink-900), var(--c-ink-950) 70%);
    border-color: rgb(25 197 139 / 0.25);
    color: var(--c-on-dark);
  }

  .p-card--custom .p-card__title {
    color: var(--c-white);
  }

  .p-card--custom .p-card__desc {
    color: var(--c-on-dark-muted);
  }

  .p-card--custom .p-card__footer {
    border-top-color: var(--c-line-dark);
  }

  .p-card__cat--dark {
    background: rgb(163 244 81 / 0.1);
    color: var(--c-lime);
  }

  .p-card__art {
    position: relative;
    height: 7.5rem;
    border-bottom: 1px solid var(--c-line-dark);
    background-image: radial-gradient(rgb(163 244 81 / 0.1) 1px, transparent 1.3px);
    background-size: 18px 18px;
  }

  .p-card__art svg {
    width: 100%;
    height: 100%;
  }

  .p-card__art-trace {
    fill: none;
    stroke: rgb(25 197 139 / 0.4);
    stroke-width: 1.3;
    stroke-linejoin: round;
  }

  .p-card__art-pulse {
    fill: none;
    stroke: var(--c-lime);
    stroke-width: 2.2;
    stroke-linecap: round;
    --pulse-len: 0.1;
    stroke-dasharray: 0.1 3;
    stroke-dashoffset: 0.1;
    animation: gc-pulse-travel 4.5s cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite;
  }

  .p-card__art-pulse--b {
    animation-delay: 2.2s;
  }

  .p-card__art-chip {
    fill: var(--c-ink-950);
    stroke: rgb(163 244 81 / 0.55);
    stroke-width: 1.2;
  }

  .p-card__art-node {
    fill: var(--c-lime);
  }

  .p-card__art-icon {
    position: absolute;
    left: 50%;
    top: 50%;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 3rem;
    color: var(--c-lime);
    transform: translate(-50%, -50%);
    transition: transform var(--dur-3) var(--ease-out);
  }

  .p-card--custom:hover .p-card__art-icon {
    transform: translate(-50%, -50%) scale(1.08);
  }

  /* ----- skeleton ----- */
  .p-card--skeleton {
    pointer-events: none;
  }

  .skel {
    position: relative;
    display: block;
    overflow: hidden;
    background: rgb(23 43 37 / 0.07);
    border-radius: var(--r-xs);
  }

  .skel::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent, rgb(255 255 255 / 0.65), transparent);
    animation: gc-shimmer 1.4s linear infinite;
  }

  .p-card__media.skel {
    border-radius: 0;
    background: rgb(23 43 37 / 0.08);
  }

  .skel--chip {
    width: 6rem;
    height: 1.4rem;
  }

  .skel--title {
    width: 70%;
    height: 1.6rem;
  }

  .skel--line {
    width: 100%;
    height: 0.85rem;
  }

  .skel--short {
    width: 80%;
  }

  .skel--tiny {
    width: 55%;
  }

  .skel--btn {
    width: 11rem;
    height: 2.75rem;
    margin-top: auto;
  }

  /* ----- notice (API unavailable / empty) ----- */
  .p-notice {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 0.9rem;
    padding: clamp(1.5rem, 4vw, 3rem);
    border-radius: var(--r-lg);
    border: 1px dashed rgb(11 68 53 / 0.3);
    background:
      radial-gradient(70% 90% at 100% 0%, rgb(25 197 139 / 0.1), transparent 60%),
      var(--c-white);
  }

  .p-notice__icon {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: var(--r-md);
    background: var(--c-ink-950);
    color: var(--c-lime);
  }

