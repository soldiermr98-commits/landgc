---
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { guideCategories, guideSection as copy } from '../../data/guide';
import { faIndex } from '../../lib/format';
---

<section class="section section--white guide" id="gilan-guide" aria-labelledby="guide-title">
  <div class="container">
    <div class="guide__head">
      <SectionHeading id="guide-title" eyebrow={copy.eyebrow} title={copy.title} description={copy.description} />
      <div class="guide__head-cta" data-reveal style="--reveal-i:3">
        <Button href={copy.cta.href} variant="dark" size="lg">{copy.cta.label}</Button>
      </div>
    </div>

    <ul class="guide__grid">
      {
        guideCategories.map((cat, i) => (
          <li class:list={['guide__tile', `guide__tile--${cat.id}`]} data-reveal style={`--reveal-i:${i}`}>
            <a class="g-tile" href={cat.href}>
              <img
                class="g-tile__img"
                src={cat.image.src}
                alt={cat.image.alt}
                width={cat.image.width}
                height={cat.image.height}
                loading="lazy"
                decoding="async"
                data-fallback
              />
              <span class="g-tile__shade" aria-hidden="true" />
              <div class="g-tile__top">
                <span class="g-tile__index" aria-hidden="true">
                  {faIndex(i + 1)}
                </span>
                <span class="g-tile__arrow" aria-hidden="true">
                  <Icon name="arrow-up-left" size={20} />
                </span>
              </div>
              <div class="g-tile__content">
                <span class="g-tile__icon" aria-hidden="true">
                  <Icon name={cat.icon} size={20} />
                </span>
                <h3 class="g-tile__title">{cat.title}</h3>
                <span class="g-tile__caption">
                  <Icon name="map-pin" size={14} />
                  {cat.caption}
                </span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .guide {
    background:
      linear-gradient(180deg, var(--c-white), var(--c-white) 55%, rgb(240 251 246 / 0.7)),
      var(--c-white);
  }

  .guide__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
  }

  .guide__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-template-rows: repeat(2, clamp(15rem, 20vw, 17.5rem));
    gap: clamp(0.85rem, 1.4vw, 1.25rem);
    margin-top: clamp(2.5rem, 4vw, 3.5rem);
  }

  .guide__tile {
    display: flex;
    min-width: 0;
  }

  .guide__tile--attractions {
    grid-column: span 2;
    grid-row: span 2;
  }

  .guide__tile--cafes {
    grid-column: span 2;
  }

  .g-tile {
    --focus-ring: var(--c-lime);
    position: relative;
    isolation: isolate;
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    border-radius: var(--r-lg);
    color: var(--c-white);
    background:
      radial-gradient(70% 80% at 30% 20%, rgb(25 197 139 / 0.35), transparent 60%),
      linear-gradient(140deg, var(--c-ink-900), var(--c-ink-950));
    box-shadow: var(--shadow-sm);
    transition: box-shadow var(--dur-3) var(--ease-out);
  }

  .g-tile__img {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.1s var(--ease-out);
  }

  .g-tile__img.is-broken {
    display: none;
  }

  .g-tile__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to top, rgb(4 28 22 / 0.92) 0%, rgb(4 28 22 / 0.55) 38%, rgb(4 28 22 / 0.05) 70%),
      linear-gradient(to bottom, rgb(4 28 22 / 0.35), transparent 30%);
    transition: opacity var(--dur-3);
  }

  .g-tile::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.12);
    transition: box-shadow var(--dur-3);
    pointer-events: none;
  }

  .g-tile:hover {
    box-shadow: 0 30px 60px -30px rgb(6 39 31 / 0.6);
  }

  .g-tile:hover::after {
    box-shadow:
      inset 0 0 0 1px rgb(163 244 81 / 0.55),
      inset 0 0 40px -10px rgb(163 244 81 / 0.25);
  }

  .g-tile:hover .g-tile__img {
    transform: scale(1.05);
  }

  .g-tile__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.1rem 1.2rem 0;
  }

  .g-tile__index {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    padding: 0.2rem 0.5rem;
    border-radius: var(--r-xs);
    background: rgb(4 28 22 / 0.55);
    color: rgb(233 247 240 / 0.85);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }

  .g-tile__arrow {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.14);
    border: 1px solid rgb(255 255 255 / 0.25);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    transition:
      background-color var(--dur-2),
      color var(--dur-2),
      transform var(--dur-3) var(--ease-out);
  }

  .g-tile:hover .g-tile__arrow {
    background: var(--c-lime);
    border-color: var(--c-lime);
    color: var(--c-ink-950);
    transform: rotate(-12deg) scale(1.05);
  }

  .g-tile__content {
    display: grid;
    justify-items: start;
    gap: 0.45rem;
    padding: 1.25rem;
  }

  .g-tile__icon {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: var(--r-md);
    background: rgb(163 244 81 / 0.16);
    border: 1px solid rgb(163 244 81 / 0.35);
    color: var(--c-lime);
    margin-bottom: 0.25rem;
  }

  .g-tile__title {
    font-size: clamp(1.1rem, 1rem + 0.5vw, 1.4rem);
    font-weight: 800;
    color: var(--c-white);
    text-shadow: 0 2px 16px rgb(0 0 0 / 0.35);
  }

  .guide__tile--attractions .g-tile__title {
    font-size: clamp(1.35rem, 1.1rem + 1vw, 2rem);
  }

  .g-tile__caption {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--fs-xs);
    font-weight: 500;
    color: rgb(233 247 240 / 0.8);
  }

  @media (max-width: 1023.98px) {
    .guide__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: none;
      grid-auto-rows: clamp(14rem, 34vw, 18rem);
    }

    .guide__tile--attractions,
    .guide__tile--cafes {
      grid-column: span 2;
      grid-row: auto;
    }
  }

  @media (max-width: 559.98px) {
    .guide__grid {
      grid-template-columns: 1fr;
      grid-auto-rows: 15rem;
    }

    .guide__tile--attractions,
    .guide__tile--cafes {
      grid-column: auto;
    }

    .guide__head-cta,
    .guide__head-cta :global(.btn) {
      width: 100%;
    }
  }
</style>
