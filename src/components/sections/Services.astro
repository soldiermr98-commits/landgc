---
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { services, servicesSection as copy } from '../../data/services';
import { faIndex } from '../../lib/format';
---

<section id="services" class="section section--white services" aria-labelledby="services-title">
  <div class="services__decor" aria-hidden="true"></div>
  <div class="container">
    <SectionHeading id="services-title" eyebrow={copy.eyebrow} title={copy.title} description={copy.description} />

    <ul class="services__grid">
      {
        services.map((service, i) => (
          <li class="services__item" data-reveal style={`--reveal-i:${i % 2}`}>
            <article class="s-card" id={service.id} aria-labelledby={`${service.id}-title`} data-spotlight>
              <div class="s-card__head">
                <span class="s-card__icon">
                  <Icon name={service.icon} size={24} />
                </span>
                <span class="s-card__index" aria-hidden="true">
                  {faIndex(i + 1)}
                </span>
              </div>
              <h3 class="s-card__title" id={`${service.id}-title`}>
                {service.title}
              </h3>
              <p class="s-card__desc">{service.description}</p>
              <ul class="s-card__list">
                {service.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
              <div class="s-card__footer">
                <Button href={service.cta.href} variant="link">
                  {service.cta.label}
                </Button>
              </div>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .services__decor {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(rgb(11 68 53 / 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgb(11 68 53 / 0.045) 1px, transparent 1px);
    background-size: 56px 56px;
    -webkit-mask-image: radial-gradient(ellipse 55% 45% at 85% 8%, #000, transparent 70%);
    mask-image: radial-gradient(ellipse 55% 45% at 85% 8%, #000, transparent 70%);
  }

  .services__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 1.6vw, 1.5rem);
    margin-top: clamp(2.5rem, 4vw, 3.5rem);
  }

  .services__item {
    display: flex;
  }

  .s-card {
    position: relative;
    isolation: isolate;
    container-type: inline-size;
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.9rem;
    padding: clamp(1.5rem, 2.6vw, 2.25rem);
    border-radius: var(--r-lg);
    border: 1px solid var(--c-line);
    background: linear-gradient(180deg, var(--c-white), #f5fcf8);
    transition:
      translate var(--dur-3) var(--ease-out),
      box-shadow var(--dur-3) var(--ease-out),
      border-color var(--dur-2);
  }

  /* top-edge circuit trace drawn on hover */
  .s-card::before {
    content: '';
    position: absolute;
    inset-inline: 1.5rem;
    top: -1px;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(to left, var(--c-green), var(--c-lime));
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.7s var(--ease-out);
  }

  .s-card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: radial-gradient(380px circle at var(--mx, 80%) var(--my, 0%), rgb(25 197 139 / 0.08), transparent 60%);
    opacity: 0;
    transition: opacity var(--dur-3);
  }

  .s-card:hover {
    translate: 0 -4px;
    border-color: rgb(25 197 139 / 0.35);
    box-shadow:
      0 28px 56px -34px rgb(6 39 31 / 0.45),
      0 0 0 1px rgb(25 197 139 / 0.12);
  }

  .s-card:hover::before {
    transform: scaleX(1);
  }

  .s-card:hover::after {
    opacity: 1;
  }

  .s-card__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 0.35rem;
  }

  .s-card__icon {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: var(--r-md);
    background: var(--c-ink-950);
    color: var(--c-lime);
    box-shadow: inset 0 0 0 1px rgb(163 244 81 / 0.18);
    transition:
      transform var(--dur-3) var(--ease-out),
      box-shadow var(--dur-3);
  }

  .s-card:hover .s-card__icon {
    transform: translateY(-3px) rotate(-4deg);
    box-shadow:
      inset 0 0 0 1px rgb(163 244 81 / 0.4),
      0 12px 24px -12px rgb(25 197 139 / 0.9);
  }

  .s-card__index {
    font-size: 2.6rem;
    font-weight: 200;
    line-height: 1;
    color: rgb(11 68 53 / 0.16);
    transition: color var(--dur-3);
  }

  .s-card:hover .s-card__index {
    color: rgb(25 197 139 / 0.45);
  }

  .s-card__title {
    font-size: var(--fs-h3);
    color: var(--c-text);
  }

  .s-card__desc {
    font-size: var(--fs-base);
    color: var(--c-text-muted);
    line-height: 1.95;
  }

  .s-card__list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.55rem 1.5rem;
    margin-block: 0.4rem 0.2rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--c-line);
  }

  @container (min-width: 460px) {
    .s-card__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .s-card__list li {
    position: relative;
    padding-inline-start: 1.25rem;
    font-size: var(--fs-sm);
    font-weight: 600;
    line-height: 1.8;
    color: var(--c-text);
  }

  /* PCB pad bullet */
  .s-card__list li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    top: 0.6em;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 2px;
    border: 1.5px solid var(--c-green);
    transform: rotate(45deg);
    transition: background-color var(--dur-2);
  }

  .s-card:hover .s-card__list li::before {
    background: var(--c-green);
  }

  .s-card__footer {
    margin-top: auto;
    padding-top: 0.5rem;
  }

  @media (max-width: 767.98px) {
    .services__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
