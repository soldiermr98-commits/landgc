---
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../ui/Icon.astro';
import CircuitField from '../circuits/CircuitField.astro';
import { benefits, benefitsSection as copy } from '../../data/benefits';
import { faIndex } from '../../lib/format';
---

<section class="section section--green benefits" id="why" aria-labelledby="why-title" data-visibility data-progress>
  <div class="benefits__bg" aria-hidden="true"></div>
  <CircuitField variant="green" tone="dark" />

  <div class="container">
    <SectionHeading id="why-title" eyebrow={copy.eyebrow} title={copy.title} align="center" tone="dark" />

    <ul class="benefits__grid">
      {
        benefits.map((b, i) => (
          <li class="benefits__item" data-reveal style={`--reveal-i:${i}`}>
            <div class="b-item">
              <div class="b-item__top">
                <span class="b-item__icon">
                  <Icon name={b.icon} size={24} />
                </span>
                <span class="b-item__index" aria-hidden="true">
                  {faIndex(i + 1)}
                </span>
              </div>
              <h3 class="b-item__title">{b.title}</h3>
              <p class="b-item__text">{b.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .benefits__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      radial-gradient(
        60% 70% at calc(35% + var(--p, 0.5) * 30%) 0%,
        rgb(25 197 139 / calc(0.14 + var(--p, 0.5) * 0.14)),
        transparent 65%
      ),
      linear-gradient(180deg, var(--c-ink-900), var(--c-ink-850) 70%, var(--c-ink-950));
  }

  .benefits__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: clamp(2.75rem, 5vw, 4rem);
    border-block: 1px solid var(--c-line-dark);
  }

  .benefits__item {
    display: flex;
  }

  .benefits__item + .benefits__item {
    border-inline-start: 1px solid var(--c-line-dark);
  }

  .b-item {
    position: relative;
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.85rem;
    padding: clamp(1.75rem, 3vw, 2.5rem) clamp(1.25rem, 2vw, 1.9rem);
    transition: background-color var(--dur-3);
  }

  /* trace highlight along the top edge on hover */
  .b-item::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    top: -1px;
    height: 2px;
    background: linear-gradient(to left, var(--c-lime), rgb(25 197 139 / 0));
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.7s var(--ease-out);
  }

  .b-item:hover {
    background: rgb(233 247 240 / 0.03);
  }

  .b-item:hover::before {
    transform: scaleX(1);
  }

  .b-item__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.6rem;
  }

  .b-item__icon {
    display: grid;
    place-items: center;
    width: 3.1rem;
    height: 3.1rem;
    border-radius: var(--r-md);
    border: 1px solid rgb(163 244 81 / 0.3);
    background: rgb(4 28 22 / 0.35);
    color: var(--c-lime);
    transition:
      transform var(--dur-3) var(--ease-out),
      box-shadow var(--dur-3);
  }

  .b-item:hover .b-item__icon {
    transform: translateY(-3px);
    box-shadow: 0 0 26px -6px rgb(163 244 81 / 0.55);
  }

  .b-item__index {
    font-size: 2.4rem;
    font-weight: 200;
    line-height: 1;
    color: rgb(233 247 240 / 0.14);
    transition: color var(--dur-3);
  }

  .b-item:hover .b-item__index {
    color: rgb(163 244 81 / 0.5);
  }

  .b-item__title {
    font-size: var(--fs-h3);
    color: var(--c-white);
  }

  .b-item__text {
    font-size: var(--fs-sm);
    line-height: 1.95;
    color: var(--c-on-dark-muted);
  }

  @media (max-width: 1023.98px) {
    .benefits__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .benefits__item:nth-child(3) {
      border-inline-start: 0;
    }

    .benefits__item:nth-child(n + 3) {
      border-top: 1px solid var(--c-line-dark);
    }
  }

  @media (max-width: 559.98px) {
    .benefits__grid {
      grid-template-columns: 1fr;
    }

    .benefits__item + .benefits__item {
      border-inline-start: 0;
      border-top: 1px solid var(--c-line-dark);
    }
  }
</style>
