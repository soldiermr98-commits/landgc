---
/**
 * Collaboration path. The connecting trace draws with scroll progress (--p) and each
 * step's node lights up as the trace reaches it. Without JS everything is shown lit.
 */
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../ui/Icon.astro';
import { processSection as copy, processSteps } from '../../data/process';
import { toFaDigits } from '../../lib/format';

const last = processSteps.length - 1;
---

<section class="section section--light process" id="process" aria-labelledby="process-title" data-progress>
  <div class="container">
    <SectionHeading id="process-title" eyebrow={copy.eyebrow} title={copy.title} align="center" />

    <ol class="process__track">
      {
        processSteps.map((step, i) => (
          <li class="process__step" style={`--t:${i / last}`} data-reveal>
            <span class="process__node" aria-hidden="true">
              <span class="process__node-ring" />
              <Icon name={step.icon} size={24} />
            </span>
            <span class="process__count">مرحله {toFaDigits(i + 1)}</span>
            <h3 class="process__title">{step.title}</h3>
            <p class="process__text">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .process {
    /* map section progress to the rail: starts as the track enters, completes near centre */
    --rail: clamp(0, calc((var(--p, 1) - 0.18) * 2.6), 1);
    padding-bottom: clamp(3rem, 5vw, 4.5rem);
  }

  .process__track {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 2rem);
    margin-top: clamp(3rem, 5vw, 4.5rem);
  }

  /* rail through the node centres (RTL: fills from right to left) */
  .process__track::before,
  .process__track::after {
    content: '';
    position: absolute;
    z-index: 0;
    top: 2rem;
    inset-inline: calc(12.5% - 0.5rem);
    height: 2px;
    pointer-events: none;
  }

  .process__track::before {
    background: repeating-linear-gradient(to left, rgb(11 68 53 / 0.22) 0 8px, transparent 8px 14px);
  }

  .process__track::after {
    background: linear-gradient(to left, var(--c-green), var(--c-lime));
    box-shadow: 0 0 12px rgb(163 244 81 / 0.6);
    transform: scaleX(var(--rail));
    transform-origin: right;
  }

  .process__step {
    --on: clamp(0, calc((var(--rail) - var(--t)) * 12 + 1), 1);
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.5rem;
  }

  .process__node {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    margin-bottom: 0.75rem;
    border-radius: var(--r-lg);
    background: var(--c-white);
    border: 1px solid var(--c-line-strong);
    color: var(--c-text-muted);
    box-shadow: var(--shadow-sm);
  }

  .process__node-ring {
    position: absolute;
    inset: -7px;
    border-radius: 18px;
    border: 1px solid rgb(163 244 81 / 0.6);
    opacity: var(--on);
    transform: scale(calc(0.85 + var(--on) * 0.15));
  }

  .process__node :global(svg) {
    position: relative;
    transition: transform var(--dur-3) var(--ease-out);
  }

  /* lit state, driven by --on */
  .process__step .process__node {
    background: color-mix(in srgb, var(--c-ink-950) calc(var(--on) * 100%), var(--c-white));
    border-color: color-mix(in srgb, var(--c-ink-950) calc(var(--on) * 100%), rgb(23 43 37 / 0.18));
    color: color-mix(in srgb, var(--c-lime) calc(var(--on) * 100%), var(--c-text-muted));
  }

  .process__step:hover .process__node :global(svg) {
    transform: scale(1.1) rotate(-6deg);
  }

  .process__count {
    font-size: var(--fs-xs);
    font-weight: 700;
    color: var(--c-green-ink);
    padding: 0.15rem 0.6rem;
    border-radius: var(--r-xs);
    background: rgb(25 197 139 / 0.1);
  }

  .process__title {
    font-size: var(--fs-h3);
    color: var(--c-text);
  }

  .process__text {
    max-width: 16rem;
    font-size: var(--fs-sm);
    line-height: 1.9;
    color: var(--c-text-muted);
  }

  @media (max-width: 899.98px) {
    .process__track {
      grid-template-columns: 1fr;
      gap: 0;
      max-width: 34rem;
      margin-inline: auto;
    }

    .process__track::before,
    .process__track::after {
      top: 2rem;
      bottom: 2rem;
      inset-inline: auto;
      inset-inline-start: calc(2rem - 1px);
      width: 2px;
      height: auto;
    }

    .process__track::before {
      background: repeating-linear-gradient(to bottom, rgb(11 68 53 / 0.22) 0 8px, transparent 8px 14px);
    }

    .process__track::after {
      transform: scaleY(var(--rail));
      transform-origin: top;
    }

    .process__step {
      display: grid;
      grid-template-columns: 4rem 1fr;
      column-gap: 1.25rem;
      align-items: start;
      text-align: start;
      padding-bottom: 2rem;
    }

    .process__node {
      grid-row: span 3;
      margin-bottom: 0;
    }

    .process__count {
      justify-self: start;
    }

    .process__text {
      max-width: none;
    }
  }

  @supports not (color: color-mix(in srgb, red 50%, blue)) {
    .process__step .process__node {
      background: var(--c-ink-950);
      border-color: var(--c-ink-950);
      color: var(--c-lime);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .process {
      --rail: 1;
    }
  }
</style>
