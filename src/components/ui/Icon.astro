---
/**
 * Inline SVG icon. Glyph data comes from Lucide (ISC) and is resolved at build time,
 * so pages ship plain <svg> markup and zero icon JavaScript.
 */
import iconNodes from 'lucide-static/icon-nodes.json';
import type { IconName } from '../../lib/icons';

interface Props {
  name: IconName;
  size?: number;
  strokeWidth?: number;
  class?: string;
  /** Provide a label only when the icon conveys meaning on its own. */
  label?: string;
}

const { name, size = 20, strokeWidth = 1.75, class: className, label } = Astro.props;

type IconNode = [string, Record<string, string | number>][];
const node = (iconNodes as unknown as Record<string, IconNode>)[name];
if (!node) throw new Error(`[Icon] Unknown Lucide icon: "${name}"`);

const escapeAttr = (value: string | number) =>
  String(value).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');

const inner = node
  .map(
    ([tag, attrs]) =>
      `<${tag} ${Object.entries(attrs)
        .filter(([key]) => key !== 'key')
        .map(([key, value]) => `${key}="${escapeAttr(value)}"`)
        .join(' ')}/>`,
  )
  .join('');
---

<svg
  class:list={['icon', className]}
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  focusable="false"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  set:html={inner}
/>

<style>
  .icon {
    flex-shrink: 0;
  }
</style>
