---
/**
 * Link-button (always an <a>; native <button>s are used directly where needed).
 * variants: primary (lime, for dark surfaces) · dark (solid ink, for light surfaces)
 *           secondary (glass outline, dark surfaces) · outline (light surfaces) · link
 * The trailing arrow points left: «forward» in a right-to-left layout.
 */
import type { HTMLAttributes } from 'astro/types';
import Icon from './Icon.astro';
import type { IconName } from '../../lib/icons';

type Variant = 'primary' | 'dark' | 'secondary' | 'outline' | 'link';

interface Props extends Omit<HTMLAttributes<'a'>, 'class'> {
  href: string;
  variant?: Variant;
  size?: 'sm' | 'md' | 'lg';
  icon?: IconName | null;
  iconStart?: IconName;
  block?: boolean;
  class?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  icon = 'arrow-left',
  iconStart,
  block = false,
  class: className,
  ...rest
} = Astro.props;

const classes = ['btn', `btn--${variant}`, `btn--${size}`, block && 'btn--block', className];
---

<a class:list={classes} href={href} {...rest}>
  {iconStart && <Icon name={iconStart} size={18} class="btn__icon btn__icon--start" />}
  <span class="btn__label"><slot /></span>
  {icon && <Icon name={icon} size={18} class="btn__icon btn__icon--end" />}
</a>

<style>
  .btn {
    --btn-bg: transparent;
    --btn-fg: currentColor;
    --btn-border: transparent;
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6em;
    min-height: 3rem;
    padding: 0.7rem 1.35rem;
    border: 1px solid var(--btn-border);
    border-radius: var(--r-sm);
    background: var(--btn-bg);
    color: var(--btn-fg);
    font-size: var(--fs-base);
    font-weight: 700;
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    transition:
      background-color var(--dur-2) var(--ease-out),
      border-color var(--dur-2) var(--ease-out),
      box-shadow var(--dur-3) var(--ease-out),
      color var(--dur-2) var(--ease-out),
      transform var(--dur-2) var(--ease-out);
  }

  .btn--sm {
    min-height: 2.5rem;
    padding: 0.45rem 1rem;
    font-size: var(--fs-sm);
  }

  .btn--lg {
    min-height: 3.375rem;
    padding: 0.85rem 1.6rem;
    font-size: var(--fs-md);
  }

  .btn--block {
    width: 100%;
  }

  .btn__label {
    position: relative;
  }

  .btn__icon {
    position: relative;
    transition: transform var(--dur-2) var(--ease-out);
  }

  .btn:hover .btn__icon--end,
  .btn:focus-visible .btn__icon--end {
    transform: translateX(-4px);
  }

  /* Light sheen sweeping right→left on hover */
  .btn::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      100deg,
      transparent 30%,
      var(--btn-sheen, rgb(255 255 255 / 0.4)) 50%,
      transparent 70%
    );
    transform: translateX(110%);
    transition: transform 0.75s var(--ease-out);
    pointer-events: none;
  }

  .btn:hover::after {
    transform: translateX(-110%);
  }

  .btn:active {
    transform: translateY(1px);
  }

  /* primary — lime, on dark surfaces */
  .btn--primary {
    --btn-bg: var(--c-lime);
    --btn-fg: var(--c-ink-950);
    --btn-border: rgb(163 244 81 / 0.8);
  }

  .btn--primary:hover {
    --btn-bg: var(--c-lime-hover);
    box-shadow: var(--glow-lime);
  }

  /* dark — solid ink, on light surfaces */
  .btn--dark {
    --btn-bg: var(--c-ink-950);
    --btn-fg: var(--c-white);
    --btn-border: var(--c-ink-950);
    --btn-sheen: rgb(163 244 81 / 0.16);
  }

  .btn--dark .btn__icon--end {
    color: var(--c-lime);
  }

  .btn--dark:hover {
    --btn-bg: var(--c-ink-900);
    box-shadow:
      0 0 0 1px rgb(25 197 139 / 0.4),
      var(--glow-green);
  }

  /* secondary — glass outline, on dark surfaces */
  .btn--secondary {
    --btn-bg: rgb(233 247 240 / 0.04);
    --btn-fg: var(--c-on-dark);
    --btn-border: rgb(233 247 240 / 0.22);
    --btn-sheen: rgb(163 244 81 / 0.12);
  }

  .btn--secondary:hover {
    --btn-bg: rgb(163 244 81 / 0.08);
    --btn-border: rgb(163 244 81 / 0.55);
    box-shadow: 0 0 28px -10px rgb(163 244 81 / 0.55);
  }

  /* outline — on light surfaces */
  .btn--outline {
    --btn-bg: var(--c-white);
    --btn-fg: var(--c-text);
    --btn-border: var(--c-line-strong);
    --btn-sheen: rgb(25 197 139 / 0.12);
  }

  .btn--outline .btn__icon--end {
    color: var(--c-green-ink);
  }

  .btn--outline:hover {
    --btn-border: var(--c-green);
    --btn-bg: rgb(25 197 139 / 0.05);
    box-shadow: 0 10px 26px -14px rgb(25 197 139 / 0.7);
  }

  /* link — text button with an animated underline */
  .btn--link {
    min-height: auto;
    padding: 0.35rem 0;
    border: 0;
    border-radius: 0;
    overflow: visible;
    font-weight: 700;
    color: var(--btn-link-color, var(--c-green-ink));
  }

  .btn--link::after {
    inset: auto 0 0 0;
    height: 1px;
    z-index: 0;
    background: currentColor;
    opacity: 0.35;
    transform: scaleX(0.25);
    transform-origin: right;
    transition:
      transform var(--dur-3) var(--ease-out),
      opacity var(--dur-2);
  }

  .btn--link:hover::after {
    transform: scaleX(1);
    opacity: 0.8;
  }

  @media (prefers-reduced-motion: reduce) {
    .btn::after {
      display: none;
    }
  }
</style>
