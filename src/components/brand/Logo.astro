---
/**
 * GilaClick lockup: a chip-shaped monogram (a «G» drawn as a circuit trace that ends
 * in a glowing node) plus the bilingual wordmark.
 * To use the official raster logo instead, replace the markup below with an <img>.
 */
interface Props {
  tone?: 'light' | 'dark';
  /** Hide the wordmark (mark only). */
  compact?: boolean;
  class?: string;
}

const { tone = 'light', compact = false, class: className } = Astro.props;
---

<span class:list={['logo', `logo--${tone}`, compact && 'logo--compact', className]}>
  <svg class="logo__mark" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
    <path
      class="logo__body"
      d="M9 1h22a8 8 0 0 1 8 8v22a8 8 0 0 1-8 8H9a8 8 0 0 1-8-8V8.2L8.2 1Z"></path>
    <path
      class="logo__trace"
      d="M26.7 13.3A9.5 9.5 0 1 0 29.4 21.3H23.2"
      fill="none"
      stroke-width="3"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
    <circle class="logo__halo" cx="21" cy="21.3" r="5"></circle>
    <circle class="logo__node" cx="21" cy="21.3" r="2.5"></circle>
  </svg>
  {
    !compact && (
      <span class="logo__type">
        <span class="logo__fa">گیلاکلیک</span>
        <span class="logo__en" lang="en" aria-hidden="true">GILACLICK</span>
      </span>
    )
  }
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    line-height: 1;
  }

  .logo__mark {
    width: 2.375rem;
    height: 2.375rem;
    flex-shrink: 0;
  }

  .logo__body {
    fill: var(--c-ink-950);
  }

  .logo__trace {
    stroke: var(--c-green);
  }

  .logo__halo {
    fill: var(--c-lime);
    opacity: 0.18;
  }

  .logo__node {
    fill: var(--c-lime);
  }

  .logo__type {
    display: grid;
    gap: 0.3rem;
  }

  .logo__fa {
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--c-text);
    letter-spacing: 0;
  }

  .logo__en {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.28em;
    color: var(--c-text-muted);
    direction: ltr;
    text-align: end;
  }

  .logo--dark .logo__body {
    fill: var(--c-ink-900);
    stroke: rgb(25 197 139 / 0.35);
    stroke-width: 1;
  }

  .logo--dark .logo__fa {
    color: var(--c-white);
  }

  .logo--dark .logo__en {
    color: var(--c-on-dark-faint);
  }
</style>
