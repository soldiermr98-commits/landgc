---
/**
 * Decorative PCB-style background for a section.
 * Sits behind content (z-index:-1, aria-hidden), never intercepts pointer events.
 * - Pulses: small light dashes travelling along selected traces (CSS only).
 * - Draw-in: selected traces are drawn progressively on page load.
 * - Parallax: optional, driven by the section's scroll progress (--p).
 * Hidden on small screens unless `mobile` is set, to keep phones light.
 */
import { fields, type FieldName } from './fields';
import { uid } from '../../lib/uid';

interface Props {
  variant: FieldName;
  tone?: 'light' | 'dark';
  mobile?: boolean;
  parallax?: boolean;
  /** very slow continuous drift of the whole layer */
  drift?: boolean;
  class?: string;
}

const { variant, tone = 'dark', mobile = false, parallax = false, drift = false, class: className } = Astro.props;
const field = fields[variant];
const glowId = uid('cf-glow');
const pulses = field.traces.filter((t) => t.pulse);
---

<div
  class:list={[
    'cf',
    `cf--${tone}`,
    mobile && 'cf--mobile',
    parallax && 'cf--parallax',
    drift && 'cf--drift',
    className,
  ]}
  aria-hidden="true"
>
  <svg
    class="cf__svg"
    viewBox={`0 0 ${field.width} ${field.height}`}
    preserveAspectRatio="xMidYMid slice"
    focusable="false"
  >
    <defs>
      <radialGradient id={glowId}>
        <stop offset="0" class="cf__glow-stop"></stop>
        <stop offset="1" class="cf__glow-stop cf__glow-stop--end"></stop>
      </radialGradient>
    </defs>

    <g class="cf__traces">
      {
        field.traces.map((t) => (
          <path
            class:list={['cf__trace', t.draw && 'cf__trace--draw']}
            d={t.d}
            pathLength="1"
            style={t.draw ? `--draw-delay:${t.draw.delay}s` : undefined}
          />
        ))
      }
    </g>

    <g class="cf__pulses">
      {
        pulses.map((t) => (
          <g
            class="cf__pulse"
            style={`--pulse-dur:${t.pulse!.dur}s;--pulse-delay:${t.pulse!.delay}s;--pulse-len:${t.pulse!.len}`}
          >
            <path class="cf__pulse-halo" d={t.d} pathLength="1" />
            <path class="cf__pulse-core" d={t.d} pathLength="1" />
          </g>
        ))
      }
    </g>

    <g class="cf__nodes">
      {
        field.nodes.map((n) =>
          n.kind === 'glow' ? (
            <g class="cf__node cf__node--glow">
              <circle cx={n.at[0]} cy={n.at[1]} r="22" fill={`url(#${glowId})`} class="cf__glow" />
              <circle cx={n.at[0]} cy={n.at[1]} r="3.4" class="cf__dot cf__dot--lit" />
            </g>
          ) : n.kind === 'pad' ? (
            <circle cx={n.at[0]} cy={n.at[1]} r="2.2" class="cf__dot" />
          ) : (
            <g class="cf__node">
              <circle cx={n.at[0]} cy={n.at[1]} r="5.4" class="cf__ring" />
              <circle cx={n.at[0]} cy={n.at[1]} r="2.4" class="cf__dot" />
            </g>
          ),
        )
      }
    </g>
  </svg>
</div>

<style>
  .cf {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }

  .cf--dark {
    --cf-trace: var(--trace-dark);
    --cf-node: var(--trace-dark-node);
    --cf-pulse: var(--c-lime);
    --cf-glow: var(--c-lime);
  }

  .cf--light {
    --cf-trace: var(--trace-light);
    --cf-node: var(--trace-light-node);
    --cf-pulse: var(--c-green);
    --cf-glow: var(--c-green);
  }

  .cf__svg {
    width: 100%;
    height: 100%;
  }

  .cf__trace {
    fill: none;
    stroke: var(--cf-trace);
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .cf__trace--draw {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: gc-draw 2.6s var(--ease-out) var(--draw-delay, 0s) both;
  }

  .cf__pulse path {
    fill: none;
    stroke: var(--cf-pulse);
    stroke-linecap: round;
    stroke-dasharray: var(--pulse-len) 3;
    stroke-dashoffset: var(--pulse-len);
    animation: gc-pulse-travel var(--pulse-dur) cubic-bezier(0.45, 0.05, 0.55, 0.95) var(--pulse-delay) infinite;
  }

  .cf__pulse-core {
    stroke-width: 2.2;
  }

  .cf__pulse-halo {
    stroke-width: 7;
    opacity: 0.22;
  }

  .cf--light .cf__pulse {
    opacity: 0.55;
  }

  .cf__dot {
    fill: var(--cf-node);
  }

  .cf__ring {
    fill: none;
    stroke: var(--cf-node);
    stroke-width: 1;
    opacity: 0.55;
  }

  .cf__dot--lit {
    fill: var(--cf-glow);
  }

  .cf__glow-stop {
    stop-color: var(--cf-glow);
    stop-opacity: 0.7;
  }

  .cf__glow-stop--end {
    stop-opacity: 0;
  }

  .cf__glow {
    --breathe-min: 0.35;
    --breathe-max: 0.95;
    animation: gc-breathe 4.8s ease-in-out infinite;
  }

  .cf--parallax,
  .cf--drift {
    inset: -48px -24px;
  }

  .cf--drift {
    animation: gc-drift 26s var(--ease-in-out) infinite alternate;
  }

  @media (min-width: 768px) and (prefers-reduced-motion: no-preference) {
    .cf--parallax .cf__svg {
      transform: translate3d(0, calc((var(--p, 0.5) - 0.5) * -80px), 0);
      will-change: transform;
    }
  }

  @media (max-width: 767.98px) {
    .cf:not(.cf--mobile) {
      display: none;
    }

    .cf--mobile .cf__pulse:nth-child(n + 3) {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cf__pulse {
      display: none;
    }

    .cf--drift {
      animation: none;
    }

    .cf__trace--draw {
      animation: none;
      stroke-dasharray: none;
      stroke-dashoffset: 0;
    }
  }
</style>
