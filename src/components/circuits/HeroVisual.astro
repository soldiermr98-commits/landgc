---
/**
 * Hero illustration: a software panel wired into PCB buses, with an IC chip and two
 * floating cards that reference GilaClick's real products (Call for Price, Hami AI).
 * Pure SVG + HTML/CSS. Everything scales with the container (container query units).
 */
import Icon from '../ui/Icon.astro';
import { bus, trace, type Trace } from '../../lib/circuit';

interface Wire extends Trace {
  pulse?: number;
}

// viewBox 600 × 560 — the panel occupies x 84–516, y 124–424 (matches the CSS below).
const groups: { traces: Trace[]; pulse?: Record<number, number>; glow?: number[] }[] = [
  { traces: bus([[178, 124], [178, 86], [146, 54], [30, 54]], { count: 3, gap: 12, stagger: 24 }), pulse: { 1: 0.4 } },
  { traces: bus([[292, 124], [292, 72], [314, 50], [314, 20]], { count: 2, gap: 12, stagger: 16 }), pulse: { 0: 2.1 }, glow: [0] },
  { traces: bus([[516, 226], [556, 226], [584, 254], [584, 374]], { count: 3, gap: 12, stagger: 22 }), pulse: { 1: 1.3 }, glow: [2] },
  { traces: bus([[84, 196], [44, 196], [20, 220], [20, 330]], { count: 2, gap: 12, stagger: 18 }) },
  { traces: bus([[318, 424], [318, 466], [290, 494], [168, 494]], { count: 3, gap: 12, stagger: 26 }), pulse: { 1: 3 } },
  { traces: [trace([[434, 424], [434, 474], [454, 494], [516, 494]]), trace([[446, 424], [446, 470], [458, 482], [516, 482]])] },
];

const wires: (Wire & { glow: boolean; endNode: boolean; delay: number })[] = groups.flatMap((g, gi) =>
  g.traces.map((t, i) => ({
    ...t,
    pulse: g.pulse?.[i],
    glow: g.glow?.includes(i) ?? false,
    endNode: gi !== 5, // the last bus terminates in the chip
    delay: 0.35 + gi * 0.16 + i * 0.07,
  })),
);

const PULSE_SPEED = 95;
const pulseStyle = (w: Wire) => {
  const dur = Math.round((w.length / PULSE_SPEED / 0.62) * 10) / 10;
  return `--pulse-dur:${dur}s;--pulse-delay:${w.pulse}s;--pulse-len:${Math.round((18 / w.length) * 1000) / 1000}`;
};
---

<div class="hv" aria-hidden="true">
  <div class="hv__glow hv__glow--a"></div>
  <div class="hv__glow hv__glow--b"></div>

  <div class="hv__float">
    <svg class="hv__circuits" viewBox="0 0 600 560" focusable="false">
      <defs>
        <radialGradient id="hv-glow-lime">
          <stop offset="0" stop-color="#a3f451" stop-opacity="0.75"></stop>
          <stop offset="1" stop-color="#a3f451" stop-opacity="0"></stop>
        </radialGradient>
        <radialGradient id="hv-glow-green">
          <stop offset="0" stop-color="#19c58b" stop-opacity="0.7"></stop>
          <stop offset="1" stop-color="#19c58b" stop-opacity="0"></stop>
        </radialGradient>
        <pattern id="hv-dots" width="16" height="16" patternUnits="userSpaceOnUse">
          <circle cx="1" cy="1" r="0.9" fill="rgb(163 244 81 / 0.12)"></circle>
        </pattern>
      </defs>

      <rect x="0" y="0" width="600" height="560" fill="url(#hv-dots)" class="hv__dots"></rect>

      <g class="hv__wires">
        {wires.map((w) => <path d={w.d} pathLength="1" class="hv__wire" style={`--draw-delay:${w.delay}s`} />)}
      </g>

      <g class="hv__pulses">
        {
          wires
            .filter((w) => w.pulse !== undefined)
            .map((w) => (
              <g class="hv__pulse" style={pulseStyle(w)}>
                <path d={w.d} pathLength="1" class="hv__pulse-halo" />
                <path d={w.d} pathLength="1" class="hv__pulse-core" />
              </g>
            ))
        }
      </g>

      <g class="hv__nodes">
        {
          wires
            .filter((w) => w.endNode)
            .map((w) =>
              w.glow ? (
                <g>
                  <circle
                    cx={w.end[0]}
                    cy={w.end[1]}
                    r="20"
                    fill={w.end[1] < 100 ? 'url(#hv-glow-lime)' : 'url(#hv-glow-green)'}
                    class="hv__halo"
                  />
                  <circle cx={w.end[0]} cy={w.end[1]} r="3.6" class={w.end[1] < 100 ? 'hv__node-lime' : 'hv__node-green'} />
                </g>
              ) : (
                <g class="hv__via">
                  <circle cx={w.end[0]} cy={w.end[1]} r="5.2" class="hv__via-ring" />
                  <circle cx={w.end[0]} cy={w.end[1]} r="2.3" class="hv__via-dot" />
                </g>
              ),
            )
        }
        {/* pads where the buses leave the panel */}
        {wires.map((w) => <rect x={w.start[0] - 2.5} y={w.start[1] - 2.5} width="5" height="5" rx="1" class="hv__pad" />)}
      </g>

      <!-- IC chip (outer group is animated; inner group carries the SVG transform) -->
      <g class="hv__chip">
        <g transform="translate(516 470)">
          <rect x="0" y="0" width="62" height="40" rx="5" class="hv__chip-body"></rect>
          {[10, 22, 34, 46].map((x) => <rect x={x} y="-6" width="5" height="6" rx="1" class="hv__chip-pin" />)}
          {[10, 22, 34, 46].map((x) => <rect x={x} y="40" width="5" height="6" rx="1" class="hv__chip-pin" />)}
          <circle cx="9" cy="9" r="2" class="hv__chip-dot"></circle>
          <text x="31" y="25" text-anchor="middle" class="hv__chip-label">GC·01</text>
        </g>
      </g>
    </svg>

    <!-- Software panel -->
    <div class="hv__panel">
      <div class="hv__bar">
        <span class="hv__dots-ui"><i></i><i></i><i></i></span>
        <span class="hv__tab"><Icon name="code-xml" size={14} /> call-for-price.php</span>
        <span class="hv__status" dir="rtl"><span class="hv__status-dot"></span>فعال</span>
      </div>
      <div class="hv__code">
        <ol class="hv__lines">
          <li><span class="t-tag">&lt;?php</span></li>
          <li><span class="t-com">// Hami · Call for Price for WooCommerce</span></li>
          <li>
            <span class="t-fn">add_filter</span><span class="t-pun">(</span>
            <span class="t-str">'woocommerce_get_price_html'</span><span class="t-pun">,</span>
          </li>
          <li class="t-indent">
            <span class="t-str">'gc_price_inquiry'</span><span class="t-pun">,</span>
            <span class="t-num">20</span><span class="t-pun">,</span> <span class="t-num">2</span>
            <span class="t-pun">);</span>
          </li>
          <li>&nbsp;</li>
          <li>
            <span class="t-kw">function</span> <span class="t-fn">gc_price_inquiry</span><span class="t-pun">(</span>
            <span class="t-var">$html</span><span class="t-pun">,</span> <span class="t-var">$product</span><span class="t-pun">)</span>
            <span class="t-pun">&#123;</span>
          </li>
          <li class="t-indent">
            <span class="t-kw">return</span> <span class="t-fn">gc_inquiry_button</span><span class="t-pun">(</span>
            <span class="t-var">$product</span><span class="t-pun">);</span><span class="hv__caret"></span>
          </li>
          <li><span class="t-pun">&#125;</span></li>
        </ol>
      </div>
      <div class="hv__pipeline" dir="rtl">
        <span class="hv__step is-done"><Icon name="check" size={13} strokeWidth={2.4} />ساخت</span>
        <span class="hv__step-line"></span>
        <span class="hv__step is-done"><Icon name="check" size={13} strokeWidth={2.4} />آزمون</span>
        <span class="hv__step-line"></span>
        <span class="hv__step is-live"><span class="hv__live-dot"></span>انتشار</span>
      </div>
    </div>
  </div>

  <!-- Floating card: plugin -->
  <div class="hv__card hv__card--plugin" dir="rtl">
    <span class="hv__card-icon"><Icon name="plug" size={18} /></span>
    <span class="hv__card-text">
      <strong>تماس برای قیمت</strong>
      <span>افزونه ووکامرس</span>
    </span>
    <span class="hv__toggle"><span class="hv__toggle-knob"></span></span>
  </div>

  <!-- Floating card: AI assistant -->
  <div class="hv__card hv__card--ai" dir="rtl">
    <div class="hv__ai-head">
      <span class="hv__card-icon hv__card-icon--ai"><Icon name="sparkles" size={16} /></span>
      <strong class="ltr">Hami AI</strong>
      <span class="hv__online">آنلاین</span>
    </div>
    <p class="hv__bubble">سلام! دنبال چه محصولی هستید؟</p>
    <span class="hv__typing"><i></i><i></i><i></i></span>
  </div>
</div>

<style>
  .hv {
    position: relative;
    width: 100%;
    max-width: 600px;
    aspect-ratio: 600 / 560;
    margin-inline: auto;
    direction: ltr;
    container-type: inline-size;
    font-size: clamp(7.5px, 2.25cqw, 13.5px);
    user-select: none;
  }

  .hv__float {
    position: absolute;
    inset: 0;
    --float-y: -7px;
    animation: gc-float 9s var(--ease-in-out) infinite;
  }

  .hv__circuits {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .hv__dots {
    mask: radial-gradient(closest-side, #000 40%, transparent);
    -webkit-mask: radial-gradient(closest-side, #000 40%, transparent);
  }

  /* glows (HTML, so they composite cheaply) */
  .hv__glow {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }

  .hv__glow--a {
    inset: 18% 12% 18% 8%;
    background: radial-gradient(closest-side, rgb(25 197 139 / 0.22), transparent 72%);
  }

  .hv__glow--b {
    width: 34%;
    aspect-ratio: 1;
    left: 58%;
    top: 4%;
    background: radial-gradient(closest-side, rgb(163 244 81 / 0.2), transparent 70%);
    --breathe-min: 0.55;
    animation: gc-breathe 5s ease-in-out infinite;
  }

  /* wires */
  .hv__wire {
    fill: none;
    stroke: rgb(25 197 139 / 0.42);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: gc-draw 1.9s var(--ease-out) var(--draw-delay, 0s) both;
  }

  .hv__pulse path {
    fill: none;
    stroke: var(--c-lime);
    stroke-linecap: round;
    stroke-dasharray: var(--pulse-len) 3;
    stroke-dashoffset: var(--pulse-len);
    animation: gc-pulse-travel var(--pulse-dur) cubic-bezier(0.45, 0.05, 0.55, 0.95) calc(var(--pulse-delay) + 2s)
      infinite;
  }

  .hv__pulse-core {
    stroke-width: 2.4;
  }

  .hv__pulse-halo {
    stroke-width: 7;
    opacity: 0.25;
  }

  .hv__via-ring {
    fill: none;
    stroke: rgb(25 197 139 / 0.45);
    stroke-width: 1;
  }

  .hv__via-dot {
    fill: rgb(25 197 139 / 0.75);
  }

  .hv__pad {
    fill: rgb(25 197 139 / 0.6);
  }

  .hv__node-lime {
    fill: var(--c-lime);
  }

  .hv__node-green {
    fill: var(--c-green);
  }

  .hv__halo {
    --breathe-min: 0.4;
    animation: gc-breathe 4.2s ease-in-out infinite;
  }

  .hv__via,
  .hv__nodes rect,
  .hv__chip {
    animation: gc-fade-slide-up 0.8s var(--ease-out) 1.6s both;
  }

  .hv__chip-body {
    fill: #0b4435;
    stroke: rgb(25 197 139 / 0.5);
    stroke-width: 1;
  }

  .hv__chip-pin {
    fill: rgb(25 197 139 / 0.55);
  }

  .hv__chip-dot {
    fill: var(--c-lime);
  }

  .hv__chip-label {
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.08em;
    fill: rgb(233 247 240 / 0.7);
  }

  /* panel */
  .hv__panel {
    position: absolute;
    left: 14%;
    top: 22.14%;
    width: 72%;
    height: 53.57%;
    display: grid;
    grid-template-rows: auto 1fr auto;
    border-radius: 0.9em;
    background: linear-gradient(180deg, rgb(13 74 58 / 0.96), rgb(7 45 35 / 0.98));
    border: 1px solid rgb(25 197 139 / 0.32);
    box-shadow:
      0 3em 6em -2.5em rgb(0 0 0 / 0.6),
      inset 0 1px 0 rgb(233 247 240 / 0.07);
    color: var(--c-on-dark);
    overflow: hidden;
    animation: gc-fade-slide-up 0.9s var(--ease-out) 0.25s both;
  }

  .hv__bar {
    display: flex;
    align-items: center;
    gap: 1em;
    padding: 0.75em 1em;
    border-bottom: 1px solid rgb(233 247 240 / 0.08);
    background: rgb(4 28 22 / 0.35);
  }

  .hv__dots-ui {
    display: flex;
    gap: 0.4em;
  }

  .hv__dots-ui i {
    width: 0.62em;
    height: 0.62em;
    border-radius: 50%;
    background: rgb(233 247 240 / 0.18);
  }

  .hv__tab {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    padding: 0.25em 0.7em;
    border-radius: 0.4em;
    background: rgb(233 247 240 / 0.06);
    font-family: var(--font-mono);
    font-size: 0.82em;
    color: rgb(233 247 240 / 0.85);
    box-shadow: inset 0 -1.5px 0 var(--c-lime);
  }

  .hv__tab :global(svg) {
    width: 1.1em;
    height: 1.1em;
    color: var(--c-green);
  }

  .hv__status {
    margin-inline-start: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    font-size: 0.82em;
    font-weight: 600;
    color: var(--c-lime);
    font-family: var(--font-sans);
  }

  .hv__status-dot,
  .hv__live-dot {
    width: 0.55em;
    height: 0.55em;
    border-radius: 50%;
    background: var(--c-lime);
    box-shadow: 0 0 0.6em 0.1em rgb(163 244 81 / 0.7);
    animation: gc-breathe 2.4s ease-in-out infinite;
  }

  .hv__code {
    padding: 0.9em 0.4em 0.6em;
    font-family: var(--font-mono);
    font-size: 0.86em;
    line-height: 1.85;
    overflow: hidden;
  }

  .hv__lines {
    counter-reset: line;
  }

  .hv__lines li {
    counter-increment: line;
    position: relative;
    padding-left: 3em;
    white-space: nowrap;
    color: rgb(233 247 240 / 0.85);
  }

  .hv__lines li::before {
    content: counter(line);
    position: absolute;
    left: 0;
    width: 2em;
    text-align: right;
    color: rgb(233 247 240 / 0.25);
  }

  .t-indent {
    text-indent: 1.6em;
  }

  .t-tag,
  .t-kw {
    color: var(--c-green);
    font-weight: 600;
  }

  .t-com {
    color: rgb(233 247 240 / 0.38);
    font-style: italic;
  }

  .t-fn {
    color: #f2fbf6;
    font-weight: 600;
  }

  .t-str {
    color: #c9eea3;
  }

  .t-var {
    color: #80dcb8;
  }

  .t-num {
    color: var(--c-lime);
  }

  .t-pun {
    color: rgb(233 247 240 / 0.55);
  }

  .hv__caret {
    display: inline-block;
    width: 0.5em;
    height: 1.1em;
    margin-left: 0.15em;
    vertical-align: -0.2em;
    background: var(--c-lime);
    animation: gc-blink 1.1s steps(1) infinite;
  }

  .hv__pipeline {
    display: flex;
    align-items: center;
    gap: 0.6em;
    padding: 0.75em 1em;
    border-top: 1px solid rgb(233 247 240 / 0.08);
    font-family: var(--font-sans);
    font-size: 0.82em;
    color: rgb(233 247 240 / 0.7);
  }

  .hv__step {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    white-space: nowrap;
  }

  .hv__step :global(svg) {
    width: 1.15em;
    height: 1.15em;
    padding: 0.12em;
    border-radius: 50%;
    background: rgb(25 197 139 / 0.18);
    color: var(--c-green);
  }

  .hv__step.is-live {
    color: var(--c-lime);
    font-weight: 600;
  }

  .hv__step-line {
    width: 2.2em;
    height: 1px;
    background: linear-gradient(to left, rgb(25 197 139 / 0.5), rgb(25 197 139 / 0.15));
  }

  /* floating cards */
  .hv__card {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 0.75em;
    padding: 0.85em 1em;
    border-radius: 0.8em;
    background: rgb(240 251 246 / 0.97);
    color: var(--c-text);
    font-family: var(--font-sans);
    box-shadow:
      0 1.8em 3.5em -1.4em rgb(0 0 0 / 0.55),
      0 0 0 1px rgb(255 255 255 / 0.6);
  }

  .hv__card--plugin {
    left: 56%;
    top: 12.5%;
    width: 41%;
    --float-y: -6px;
    animation:
      gc-fade-slide-up 0.8s var(--ease-out) 0.9s both,
      gc-float 7.5s var(--ease-in-out) 1.7s infinite;
  }

  .hv__card--ai {
    left: 2%;
    top: 69%;
    width: 43%;
    flex-direction: column;
    align-items: stretch;
    gap: 0.55em;
    --float-y: -5px;
    animation:
      gc-fade-slide-up 0.8s var(--ease-out) 1.25s both,
      gc-float 9.5s var(--ease-in-out) 2.1s infinite;
  }

  .hv__card-icon {
    display: grid;
    place-items: center;
    width: 2.6em;
    height: 2.6em;
    flex-shrink: 0;
    border-radius: 0.6em;
    background: var(--c-ink-950);
    color: var(--c-lime);
  }

  .hv__card-icon :global(svg) {
    width: 1.35em;
    height: 1.35em;
  }

  .hv__card-icon--ai {
    width: 2.1em;
    height: 2.1em;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--c-green), var(--c-ink-900));
    color: var(--c-white);
  }

  .hv__card-icon--ai :global(svg) {
    width: 1.1em;
    height: 1.1em;
  }

  .hv__card-text {
    display: grid;
    gap: 0.15em;
    line-height: 1.5;
    min-width: 0;
  }

  .hv__card-text strong {
    font-size: 1em;
    font-weight: 800;
    white-space: nowrap;
  }

  .hv__card-text span {
    font-size: 0.82em;
    color: var(--c-text-muted);
  }

  .hv__toggle {
    position: relative;
    margin-inline-start: auto;
    width: 2.7em;
    height: 1.5em;
    flex-shrink: 0;
    border-radius: 1em;
    background: rgb(23 43 37 / 0.15);
    animation: hv-toggle-track 0.35s var(--ease-out) 1.9s both;
  }

  .hv__toggle-knob {
    position: absolute;
    top: 0.18em;
    right: 0.18em;
    width: 1.14em;
    height: 1.14em;
    border-radius: 50%;
    background: var(--c-white);
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.25);
    animation: hv-toggle-knob 0.35s var(--ease-out) 1.9s both;
  }

  @keyframes hv-toggle-track {
    to {
      background: var(--c-lime);
      box-shadow: 0 0 1.2em -0.1em rgb(163 244 81 / 0.8);
    }
  }

  @keyframes hv-toggle-knob {
    to {
      transform: translateX(-1.2em);
      background: var(--c-ink-950);
    }
  }

  .hv__ai-head {
    display: flex;
    align-items: center;
    gap: 0.5em;
    font-size: 0.92em;
  }

  .hv__ai-head strong {
    font-weight: 800;
  }

  .hv__online {
    margin-inline-start: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    font-size: 0.78em;
    color: var(--c-green-ink);
  }

  .hv__online::before {
    content: '';
    width: 0.5em;
    height: 0.5em;
    border-radius: 50%;
    background: var(--c-green);
  }

  .hv__bubble {
    padding: 0.6em 0.8em;
    border-radius: 0.7em 0.2em 0.7em 0.7em;
    background: var(--c-white);
    border: 1px solid var(--c-line);
    font-size: 0.88em;
    line-height: 1.7;
  }

  .hv__typing {
    display: inline-flex;
    gap: 0.3em;
    padding-inline: 0.4em;
  }

  .hv__typing i {
    width: 0.42em;
    height: 0.42em;
    border-radius: 50%;
    background: var(--c-green);
    animation: gc-breathe 1.2s ease-in-out infinite;
    --breathe-min: 0.25;
  }

  .hv__typing i:nth-child(2) {
    animation-delay: 0.2s;
  }

  .hv__typing i:nth-child(3) {
    animation-delay: 0.4s;
  }

  @media (max-width: 767.98px) {
    .hv__pulse:nth-child(n + 3) {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hv__pulse {
      display: none;
    }

    .hv__wire {
      animation: none;
      stroke-dasharray: none;
      stroke-dashoffset: 0;
    }

    .hv__toggle {
      background: var(--c-lime);
    }

    .hv__toggle-knob {
      transform: translateX(-1.2em);
      background: var(--c-ink-950);
    }
  }
</style>
