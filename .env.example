# Base URL of the WooCommerce Store API used by the products section.
# Default (unset): "/wp-json/wc/store/v1" — same origin, which is what you want when the
# page is served from gilaclick.ir itself.
# Set an absolute URL only when the page is hosted on another origin, and then allow that
# origin in WordPress (see README → «میزبانی روی دامنه دیگر»).
# PUBLIC_STORE_API=https://gilaclick.ir/wp-json/wc/store/v1

# Optional: where built assets (_astro/*) will be served from.
# ASSETS_PREFIX=https://gilaclick.ir/wp-content/themes/gilaclick-child/home
